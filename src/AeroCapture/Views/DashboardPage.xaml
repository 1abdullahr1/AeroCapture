<Page
    x:Class="AeroCapture.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,32">
        <StackPanel Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">
            
            <!-- Hero Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="AeroCapture" Style="{ThemeResource TitleLargeTextBlockStyle}" FontWeight="Bold" />
                    <TextBlock Text="High-performance screen recording and screenshot studio" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Hardware Acceleration Badge -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE945;" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="EncoderBadgeText" Text="Detecting Hardware Encoder..." FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Screen Recording Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="Screen Recording" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Full Screen Record -->
                    <Button Grid.Column="0" Height="140" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20" CornerRadius="8" Click="OnRecordFullscreenClicked">
                        <StackPanel Spacing="10">
                            <FontIcon Glyph="&#xE7F4;" FontSize="28" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="Full Screen" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16" />
                            <TextBlock Text="Record all monitors or primary display" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <!-- Selected Region Record -->
                    <Button Grid.Column="1" Height="140" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20" CornerRadius="8" Click="OnRecordRegionClicked">
                        <StackPanel Spacing="10">
                            <FontIcon Glyph="&#xE759;" FontSize="28" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="Selected Region" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16" />
                            <TextBlock Text="Drag and select a precise custom area" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <!-- Window Record -->
                    <Button Grid.Column="2" Height="140" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20" CornerRadius="8" Click="OnRecordWindowClicked">
                        <StackPanel Spacing="10">
                            <FontIcon Glyph="&#xE7C4;" FontSize="28" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="Window / App" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16" />
                            <TextBlock Text="Record a specific application window" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Screenshot Capture Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="Screenshot Capture" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Full Screen Screenshot -->
                    <Button Grid.Column="0" Height="120" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20" CornerRadius="8" Click="OnScreenshotFullscreenClicked">
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xE722;" FontSize="24" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="Capture Full Screen" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Instant snapshot of entire screen (Ctrl + PrtScn)" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Selected Region Screenshot -->
                    <Button Grid.Column="1" Height="120" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20" CornerRadius="8" Click="OnScreenshotRegionClicked">
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xEE71;" FontSize="24" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="Capture Region &amp; Annotate" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Snipping tool with modern annotation studio (PrtScn)" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Audio & Settings Quick Panel -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Audio Sources for Recording" Style="{ThemeResource BodyStrongTextBlockStyle}" />

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- System Audio Loopback Toggle -->
                        <StackPanel Grid.Column="0" Spacing="8">
                            <ToggleSwitch x:Name="SystemAudioSwitch" Header="System Audio (Speakers/Headphones)" IsOn="True" Toggled="OnSystemAudioToggled" />
                            <ProgressBar x:Name="SystemAudioMeter" Height="4" Maximum="1.0" Value="0" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        </StackPanel>

                        <!-- Microphone Toggle -->
                        <StackPanel Grid.Column="1" Spacing="8">
                            <ToggleSwitch x:Name="MicAudioSwitch" Header="Microphone Input" IsOn="False" Toggled="OnMicAudioToggled" />
                            <ProgressBar x:Name="MicAudioMeter" Height="4" Maximum="1.0" Value="0" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
