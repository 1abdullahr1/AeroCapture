<Window
    x:Class="AeroCapture.Views.RecordingControlBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AeroCapture Recording Bar">

    <Border Background="#EE1E1E1E" BorderBrush="#444444" BorderThickness="1" CornerRadius="20" Padding="14,8" PointerPressed="OnDragPressed">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            
            <!-- Red Indicator Dot -->
            <Ellipse x:Name="IndicatorDot" Width="12" Height="12" Fill="#FF3B30" VerticalAlignment="Center" />

            <!-- Duration Timer -->
            <TextBlock x:Name="TimerText" Text="00:00:00" Foreground="White" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />

            <!-- Audio Level Mini Meter -->
            <ProgressBar x:Name="AudioMeter" Width="40" Height="4" Maximum="1.0" Value="0" Foreground="#0078D4" VerticalAlignment="Center" />

            <Rectangle Width="1" Height="18" Fill="#444444" />

            <!-- Pause / Resume Button -->
            <Button x:Name="PauseResumeBtn" Padding="8,4" CornerRadius="12" Click="OnPauseResumeClicked" ToolTipService.ToolTip="Pause / Resume">
                <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="13" Foreground="White" />
            </Button>

            <!-- Stop Button -->
            <Button Padding="8,4" CornerRadius="12" Background="#FF3B30" Click="OnStopClicked" ToolTipService.ToolTip="Stop &amp; Save">
                <FontIcon Glyph="&#xE71A;" FontSize="13" Foreground="White" />
            </Button>
        </StackPanel>
    </Border>
</Window>
