<Window
    x:Class="AeroCapture.Views.CaptureOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AeroCapture Overlay">

    <Grid x:Name="RootGrid" Background="#66000000" PointerPressed="OnPointerPressed" PointerMoved="OnPointerMoved" PointerReleased="OnPointerReleased" KeyDown="OnKeyDown">
        <!-- Canvas for Selection Rectangle -->
        <Canvas x:Name="OverlayCanvas">
            <!-- Selected Region Border -->
            <Border x:Name="SelectionBox" BorderBrush="#0078D4" BorderThickness="2" Background="#220078D4" Visibility="Collapsed">
                <Grid>
                    <!-- Size Badge -->
                    <Border Background="#DD111111" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-28,0,0">
                        <TextBlock x:Name="DimensionText" Text="0 × 0" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    </Border>

                    <!-- Quick Action Bar -->
                    <Border x:Name="ActionBar" Background="#EE202020" BorderBrush="#444444" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,-42" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="RecordActionBtn" Style="{ThemeResource AccentButtonStyle}" Padding="8,4" Click="OnRecordClicked">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE714;" FontSize="12" />
                                    <TextBlock Text="Record" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ScreenshotActionBtn" Padding="8,4" Click="OnScreenshotClicked">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xEB9F;" FontSize="12" />
                                    <TextBlock Text="Capture" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Padding="6,4" Click="OnCancelClicked" ToolTipService.ToolTip="Cancel (Esc)">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Guide Text -->
            <Border Background="#CC111111" CornerRadius="8" Padding="16,10" HorizontalAlignment="Center" Canvas.Left="50" Canvas.Top="30">
                <TextBlock Text="Click and drag to select a region • Hover over a window to snap • Press ESC to cancel" Foreground="White" FontSize="13" />
            </Border>
        </Canvas>
    </Grid>
</Window>
